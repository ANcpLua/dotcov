<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Measure shipping assemblies, excluding generated code and compiler scaffolding. -->
  <PropertyGroup Condition="'$(Coverage)' == 'true'">
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --coverlet --coverlet-output-format cobertura --coverlet-file-prefix dotcov --coverlet-include [DotCov]* --coverlet-include [DotCov.Tool]* --coverlet-include [DotCov.Fallout]* --coverlet-exclude-by-attribute System.Runtime.CompilerServices.CompilerGeneratedAttribute --coverlet-exclude-by-attribute System.CodeDom.Compiler.GeneratedCodeAttribute --coverlet-exclude-by-file **/obj/**/*.cs</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\build\DotCov.Build.csproj" />
    <ProjectReference Include="..\..\src\DotCov\DotCov.csproj" />
    <ProjectReference Include="..\..\src\DotCov.Tool\DotCov.Tool.csproj" />
    <ProjectReference Include="..\..\src\DotCov.Fallout\DotCov.Fallout.csproj" />
    <ProjectReference Include="..\DotCov.Fallout.TestBuild\DotCov.Fallout.TestBuild.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="coverlet.MTP" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recursive: the emitter corpus lives in Fixtures\Corpus\<producer>\... subdirectories. -->
    <None Update="Fixtures\**\*.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
