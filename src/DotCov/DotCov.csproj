<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DotCov</RootNamespace>
    <!-- LibraryImport (Ansi.cs P/Invokes) source-generates unsafe marshalling stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Turns on the trim/AOT/single-file analyzers at build time. With TreatWarningsAsErrors,
         any IL2026/IL3050 (reflection/dynamic-code) regression becomes a build error — the
         library's Native-AOT cleanliness is enforced by the compiler, not by convention. -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Streaming Cobertura XML parser for .NET. Parse, merge, threshold, and diff coverage reports from your own code. Zero dependencies, Native-AOT clean, no full-DOM load.</Description>
    <PackageTags>$(PackageTags);xml;parser;aot;library</PackageTags>
  </PropertyGroup>

</Project>
